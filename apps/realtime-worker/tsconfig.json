{
  "compilerOptions": {

    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "paths": {
      "@test/*": ["./test/*"],
      "@/*": ["./src/*"],
      "~/*": ["./src/api/*"],
      "*": ["./*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": [
    "worker/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx",
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "react-router.config.ts",
    "vite.config.ts",
    "test/**/*.ts"
  ]
}
