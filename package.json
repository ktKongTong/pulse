{
  "name": "pulse-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev:worker": "pnpm --filter @pulse/realtime-worker-v2 dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm -r typecheck && pnpm -r test",
    "check:native": "./gradlew --no-daemon -Dorg.gradle.vfs.watch=false :common:compileKotlinJvm :common:compileKotlinMacosArm64",
    "check:all": "pnpm check && pnpm check:native",
    "native:start": "./scripts/dev-pulse-native.sh --verify"
  }
}
